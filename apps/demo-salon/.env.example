# Copy to .env.local for a local build that reads real Content. Both variables
# are set in this Site's Vercel project; both are read at build time only.

# The Tenant whose Content this Site serves. Each Site is its own deployment, so
# this is baked in rather than resolved from the request.
TENANT_ID=demo-salon

# The Firebase service account JSON, base64-encoded (a private key's newlines do
# not survive being pasted raw). Never a file in the repo.
#   base64 -i service-account.json | pbcopy
FIREBASE_SERVICE_ACCOUNT=
