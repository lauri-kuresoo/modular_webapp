{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },

    "@salon/core#build": { "dependsOn": ["^build"], "outputs": [] },
    "@salon/theme#build": { "dependsOn": ["^build"], "outputs": [] },
    "@salon/ui#build": { "dependsOn": ["^build"], "outputs": [] },
    "@salon/data#build": { "dependsOn": ["^build"], "outputs": [] },
    "@salon/booking#build": { "dependsOn": ["^build"], "outputs": [] }
  }
}
