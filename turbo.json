{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["TENANT_ID", "FIREBASE_SERVICE_ACCOUNT"],
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },

    "@salon/core#build": { "dependsOn": ["^build"], "outputs": [], "env": [], "cache": true },
    "@salon/theme#build": { "dependsOn": ["^build"], "outputs": [], "env": [], "cache": true },
    "@salon/ui#build": { "dependsOn": ["^build"], "outputs": [], "env": [], "cache": true },
    "@salon/data#build": { "dependsOn": ["^build"], "outputs": [], "env": [], "cache": true },
    "@salon/booking#build": { "dependsOn": ["^build"], "outputs": [], "env": [], "cache": true }
  }
}
